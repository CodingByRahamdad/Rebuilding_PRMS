# Copy this file to .env and fill in real values. Never commit your .env file.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database — MongoDB Atlas (or local) connection string.
MONGODB_URI="mongodb://127.0.0.1:27017/prms"

# JWT Authentication
# Generate strong random values with: openssl rand -hex 32
# DO NOT reuse these example values anywhere real — the app will refuse to
# start in production if JWT_SECRET/JWT_REFRESH_SECRET are left unset.
JWT_SECRET="change_me_to_a_random_32+_char_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_to_a_different_random_32+_char_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
# Origin(s) of the separately-hosted frontend app, comma-separated if more
# than one (e.g. "https://app.example.com,https://admin.example.com").
# The default below matches the frontend's Vite dev server port.
# "*" is only acceptable for local development.
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
# Stricter limit applied only to /auth/login, /auth/refresh-token,
# /auth/forgot-password, /auth/reset-password to slow down brute-forcing.
AUTH_RATE_LIMIT_MAX=10

# Application Operating Mode
# true  = auto-seed demo/sample data on first boot if the database is empty
#         (safe for a fresh local/dev database, NOT for a real DB you
#         intend to hold real patient data)
# false = never auto-seed. Use `npm run create-admin` once to bootstrap
#         your first real Super Admin account instead.
ENABLE_DEMO_MODE=true
