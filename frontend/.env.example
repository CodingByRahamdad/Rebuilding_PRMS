# Copy this file to .env and fill in real values only if needed.
# Never commit your .env file. Only VITE_-prefixed variables are ever
# bundled into the browser build — do NOT put backend secrets here.

# Leave unset for local dev — the Vite dev server proxy (see vite.config.ts)
# forwards /api and /socket.io requests to the backend automatically, so
# the app keeps using same-origin relative URLs exactly as before.
# Only set these for a production build where frontend and backend are
# served from genuinely different hosts.
# VITE_API_BASE_URL="http://localhost:3000"
# VITE_SOCKET_URL="http://localhost:3000"

# Overrides the dev-server proxy target if the backend runs on a
# non-default port/host during local development.
# VITE_DEV_PROXY_TARGET="http://localhost:3000"

# Demo-mode fallback flag consumed by src/utils/demoMode.ts. The
# authoritative source of truth is still the backend's GET /api/v1/config
# response — this is only a build-time fallback, not the source of truth.
VITE_ENABLE_DEMO_MODE=true
